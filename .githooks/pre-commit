#!/bin/sh
# Refuses a commit the checks would fail. Enabled per clone with:
#   git config core.hooksPath .githooks
# Selective: it tests the packages the staged files belong to and every package that
# imports them (directly, or in its tests), not the whole tree; a document-only commit
# runs the document checks. A commit touching web/, the schema or this hook first runs
# the frontend gates (pnpm -C web run verify, then the svelte-autofixer gate) and needs
# pnpm and web/node_modules for it; any other commit needs no Node. `go build ./...`
# always runs. The full `go test ./...` stays the implementer's job at each step's close
# (milestone-workflow). go.mod, go.sum or this hook changing runs everything. Bypass
# only knowingly: git commit --no-verify.
set -u

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$staged" ] && exit 0

fail() {
	echo "pre-commit: $1 — commit refused" >&2
	exit 1
}

# The tests run without the GIT_* this hook is given (GIT_DIR, GIT_INDEX_FILE ...): a
# test's own git would otherwise act on the repository being committed (m2l step 3: a
# `git init` set core.bare in the shared config, a `git add` rewrote the index).
run_tests() { # packages...
	out=$(
		for v in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
		go test -count=1 "$@" 2>&1
	) || {
		printf '%s\n' "$out" | grep -v '^droidyard' | grep -E -A8 '^(--- FAIL|panic)' >&2
		fail "go test failed"
	}
}

# The frontend gates (ADR-0039 §3, ADR-0040 §3). They run before the Go part, and only
# when the commit touches web/, the schema or this hook, so a Go-only or document-only
# commit never needs Node or pnpm.
if printf '%s\n' "$staged" | grep -qE '^(web/|schema/capabilities\.json$|\.githooks/)'; then
	have_frontend=1
	command -v pnpm >/dev/null 2>&1 && command -v node >/dev/null 2>&1 || have_frontend=0
	[ -d web/node_modules ] || have_frontend=0
	[ "$have_frontend" = 1 ] ||
		fail "frontend gate: pnpm, node or web/node_modules is missing; run: pnpm -C web install --frozen-lockfile"
	if printf '%s\n' "$staged" | grep -qE '^web/(package\.json|pnpm-lock\.yaml)$'; then
		# The pins first: a range would otherwise surface as a lockfile mismatch.
		node web/scripts/check-pins.mjs >&2 ||
			fail "frontend gate (dependency pins): web/package.json holds a version that is not exact"
		pnpm -C web install --frozen-lockfile --offline >&2 ||
			fail "frontend gate (pnpm install --frozen-lockfile --offline): the lockfile does not match package.json, or a package is not in the store"
	fi
	pnpm -C web run verify >&2 ||
		fail "frontend gate (pnpm -C web run verify: pins, svelte-check, tests, build) failed"
	svelte_files=$(printf '%s\n' "$staged" | grep -E '\.svelte(\.ts|\.js)?$' || true)
	existing_svelte=$(for f in $svelte_files; do [ -f "$f" ] && echo "$f"; done)
	if [ -n "$existing_svelte" ]; then
		node web/scripts/autofixer-gate.mjs $existing_svelte >&2 ||
			fail "frontend gate (svelte-autofixer): issues in the staged .svelte, .svelte.ts or .svelte.js files"
	fi
fi

if ! printf '%s\n' "$staged" | grep -qvE '^(docs/|AGENTS\.md$|\.claude/|\.opencode/)'; then
	run_tests ./internal/doccheck
	exit 0
fi

go_files=$(printf '%s\n' "$staged" | grep -E '\.go$' || true)
if [ -n "$go_files" ]; then
	existing=$(for f in $go_files; do [ -f "$f" ] && echo "$f"; done)
	if [ -n "$existing" ]; then
		unformatted=$(gofmt -l $existing)
		[ -n "$unformatted" ] && fail "gofmt -l lists: $unformatted"
	fi
fi
go build ./... || fail "go build failed"

module=$(go list -m)
if printf '%s\n' "$staged" | grep -qE '^(go\.mod|go\.sum|\.githooks/)'; then
	pkgs="./..."
else
	# The package of each staged file: a .go file's directory; a file under testdata/
	# (or any non-Go file) belongs to the nearest directory holding Go files.
	changed=""
	for f in $staged; do
		d=$(dirname "$f")
		case $f in
			schema/*) d=internal/schema ;;
			install.sh | .github/*) d=release ;; # the release package's tests read them (m2m)
		esac
		while [ "$d" != "." ] && ! ls "$d"/*.go >/dev/null 2>&1; do d=$(dirname "$d"); done
		[ "$d" = "." ] && continue
		changed="$changed $module/$d"
	done
	changed=$(printf '%s\n' $changed | sort -u)
	# Every package whose imports, transitive imports or test imports name a changed one.
	pkgs=$(go list -f '{{.ImportPath}} {{join .Deps " "}} {{join .TestImports " "}} {{join .XTestImports " "}}' ./... |
		awk -v c="$(printf '%s ' $changed)" 'BEGIN{n=split(c,a," "); for(i=1;i<=n;i++) want[a[i]]=1}
			{for(i=1;i<=NF;i++) if($i in want){print $1; break}}' | sort -u)
	if printf '%s\n' "$staged" | grep -qE '^(docs/|AGENTS\.md$)'; then
		pkgs="$pkgs $module/internal/doccheck"
	fi
fi
[ -z "$pkgs" ] && exit 0
go vet $pkgs || fail "go vet failed"
run_tests $pkgs
exit 0
