<?xml version="1.0" encoding="utf-8"?>
<!-- The 1f fixture app (D14). One launcher activity, minSdk 24, targetSdk 36; the
     LAUNCHER category is what makes the activity launchable, and step 2's check sees
     the build fail without it. The second activity is the m1n socket probe, started
     explicitly rather than from the launcher. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.droidyard.formapp">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <!-- m2w step 1: WidgetsActivity's `notify` posts a notification; on API 33 and later
         the runtime grant is made with `pm grant`, never from the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Form App"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".FormActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The socket probe (plan m1n step 2): started explicitly with
             `am start -n dev.droidyard.formapp/.ProbeActivity -e socket <name> -e request
             <line>`, from the app's own uid and domain, and exported so `am start` can
             reach it. It is not a launcher. -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true" />
        <!-- m2w step 1: the widgets the spike reads (events, windows, the full dump), started
             with `am start -n dev.droidyard.formapp/.WidgetsActivity`. Not a launcher. -->
        <activity
            android:name=".WidgetsActivity"
            android:exported="true"
            android:excludeFromRecents="true" />
        <!-- m2y step 1: a screen that changes only on touch (the colour follows the finger,
             black on the lift, magenta on a cancel, green steps on a wheel), started with
             `am start -n dev.droidyard.formapp/.TouchActivity`. Not a launcher. -->
        <activity
            android:name=".TouchActivity"
            android:exported="true"
            android:excludeFromRecents="true" />
    </application>
</manifest>
