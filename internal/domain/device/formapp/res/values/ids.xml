<?xml version="1.0" encoding="utf-8"?>
<!-- The resource ids the activity sets on its views by code; the reader reports them
     as `<package>:id/<name>`, and the device selector strips the package prefix, so
     these are the `id`s the level-5 checks select on. The two "Twin" buttons have no
     id on purpose: their text is the ambiguous selector. -->
<resources>
    <item name="name" type="id" />
    <item name="greeting" type="id" />
    <item name="greet" type="id" />
    <item name="likes" type="id" />
    <item name="like" type="id" />
    <item name="banner" type="id" />
    <item name="dismiss" type="id" />
    <item name="disabled" type="id" />
    <!-- m1n step 2: the spike's controls. crash throws on the main thread (an app
         crash); freeze blocks the main thread for 15 s (an ANR); password is a masked
         field; probe_result shows ProbeActivity's socket reply. -->
    <item name="crash" type="id" />
    <item name="freeze" type="id" />
    <item name="password" type="id" />
    <!-- m2p step 1: the Secure toggle (FLAG_SECURE on the window). -->
    <item name="secure" type="id" />
    <item name="probe_result" type="id" />
    <!-- m2w step 1: WidgetsActivity's controls (events, windows and the full dump). -->
    <item name="toast" type="id" />
    <item name="notify" type="id" />
    <item name="list" type="id" />
    <item name="level" type="id" />
    <item name="wifi" type="id" />
    <item name="title" type="id" />
    <item name="help" type="id" />
    <item name="email" type="id" />
    <item name="link" type="id" />
    <item name="hidden" type="id" />
    <item name="dialog" type="id" />
    <item name="spinner" type="id" />
</resources>
