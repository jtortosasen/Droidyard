{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  // Droidyard's implementer runs (AGENTS.md §Agents and models): pi runs headless (-p),
  // so an `ask` is a deny. The implementer edits and tests in its worktree; staging,
  // committing and discarding are the orchestrating session's; a device and the shared
  // adb server are never touched (plan m1f §Emulator rules).
  "permissionReviewLog": true,
  "permission": {
    "*": "allow",
    "external_directory_read": { "*": "allow" },
    "external_directory_write": {
      "*": "ask",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*": "allow",
      "/private/var/folders/*": "allow"
    },
    "bash": {
      "*": "allow",
      "git add *": { "action": "deny", "reason": "staging is the orchestrating session's" },
      "git commit *": { "action": "deny", "reason": "committing is the orchestrating session's" },
      "git push *": "deny",
      "git reset *": "deny",
      "git checkout *": "deny",
      "git restore *": "deny",
      "git stash *": "deny",
      "git clean *": "deny",
      "git rebase *": "deny",
      "git merge *": "deny",
      "git switch *": "deny",
      "git worktree *": "deny",
      "adb *": { "action": "deny", "reason": "a device is touched only by the orchestrating session's level-5 runs" },
      "*/adb *": { "action": "deny", "reason": "a device is touched only by the orchestrating session's level-5 runs" },
      "emulator *": "deny",
      "*/emulator *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  }
}
