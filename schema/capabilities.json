{
  "version": "0.2.0",
  "capabilities": [
    {
      "name": "operation.cancel",
      "kind": "command",
      "scope": "global",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.1.0",
      "description": "Asks a running operation to stop, whichever session started it. It does not wait: call operation.wait to see the operation end cancelled. Cancelling a finished operation does nothing.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "errors": [
        "OPERATION_NOT_FOUND"
      ],
      "input": {
        "properties": {
          "operationId": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operationId"
        ]
      },
      "output": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      }
    },
    {
      "name": "operation.wait",
      "kind": "query",
      "scope": "global",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.1.0",
      "description": "Waits for an operation to finish, up to timeoutMs, and returns it: its state, its progress, and its result once completed. timeoutMs 0 reports the current state without waiting. Waiting never affects the operation.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "errors": [
        "OPERATION_NOT_FOUND",
        "OPERATION_CANCELLED"
      ],
      "input": {
        "properties": {
          "operationId": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operationId"
        ]
      },
      "output": {
        "properties": {
          "operationId": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "progress": {
            "properties": {
              "phase": {
                "type": "string"
              },
              "done": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "blockedBy": {
            "properties": {
              "operationId": {
                "type": "string"
              },
              "capability": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "result": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operationId",
          "capability",
          "state"
        ]
      }
    },
    {
      "name": "system.capabilities",
      "kind": "query",
      "scope": "global",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.1.0",
      "description": "Lists every capability the core exposes, with its scope, statefulness, annotations and availability. This is the discovery entry point: it reports what is available rather than assuming a fixed surface.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "input": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      },
      "output": {
        "properties": {
          "version": {
            "type": "string"
          },
          "capabilities": {
            "items": {
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "statefulness": {
                  "type": "string"
                },
                "longRunning": {
                  "type": "boolean"
                },
                "audience": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "available": {
                  "type": "boolean"
                },
                "unavailableReason": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "type": "object"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object"
      }
    },
    {
      "name": "system.health",
      "kind": "query",
      "scope": "global",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.1.0",
      "description": "Reports whether the core is alive, its version, how long it has been running, how many operations are in flight, and any state file it could not use (stateProblems: corrupt files moved aside, or files of a newer version left untouched).",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "input": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      },
      "output": {
        "properties": {
          "uptimeSeconds": {
            "type": "integer"
          },
          "version": {
            "type": "string"
          },
          "operations": {
            "type": "integer"
          },
          "stateProblems": {
            "items": {
              "properties": {
                "file": {
                  "type": "string"
                },
                "problem": {
                  "type": "string",
                  "enum": [
                    "corrupt",
                    "newerVersion"
                  ]
                },
                "movedTo": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "file",
                "problem"
              ]
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object"
      }
    },
    {
      "name": "workspace.close",
      "kind": "command",
      "scope": "workspace",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.2.0",
      "description": "Closes the workspace for every session: cancels its running operations, waits for them for up to 10 s, stops its processes, and returns once it is closed. Closing a workspace that is not open does nothing.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "input": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      },
      "output": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      }
    },
    {
      "name": "workspace.describe",
      "kind": "query",
      "scope": "workspace",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.2.0",
      "description": "Describes the open workspace: its id, root, state, whether it is trusted, and, when degraded, why.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "errors": [
        "WORKSPACE_STATE_NEWER"
      ],
      "input": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      },
      "output": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ]
          },
          "trusted": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "degradedBy": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "cause": {
                "type": "string"
              },
              "nextStep": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "code",
              "message"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "root",
          "state",
          "trusted"
        ]
      }
    },
    {
      "name": "workspace.open",
      "kind": "command",
      "scope": "workspace",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.2.0",
      "description": "Opens the workspace for a project root, or returns its state if it is already open, so sessions share it. Opening reads droidyard's own state for the root and runs no project code. Workspace tools need an open workspace; an MCP session opens its bound root when it starts, so call this only to reopen it after a close.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "errors": [
        "WORKSPACE_ROOT_INVALID",
        "WORKSPACE_STATE_NEWER",
        "WORKSPACE_STATE_UNREADABLE"
      ],
      "input": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      },
      "output": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ]
          },
          "trusted": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "degradedBy": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "cause": {
                "type": "string"
              },
              "nextStep": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "code",
              "message"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "root",
          "state",
          "trusted"
        ]
      }
    }
  ]
}
