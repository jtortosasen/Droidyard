{
  "version": "0.1.0",
  "capabilities": [
    {
      "name": "operation.cancel",
      "kind": "command",
      "scope": "global",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.1.0",
      "description": "Asks a running operation to stop, whichever session started it. It does not wait: call operation.wait to see the operation end cancelled. Cancelling a finished operation does nothing.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "errors": [
        "OPERATION_NOT_FOUND"
      ],
      "input": {
        "properties": {
          "operationId": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operationId"
        ]
      },
      "output": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      }
    },
    {
      "name": "operation.wait",
      "kind": "query",
      "scope": "global",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.1.0",
      "description": "Waits for an operation to finish, up to timeoutMs, and returns it: its state, its progress, and its result once completed. timeoutMs 0 reports the current state without waiting. Waiting never affects the operation.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "errors": [
        "OPERATION_NOT_FOUND",
        "OPERATION_CANCELLED"
      ],
      "input": {
        "properties": {
          "operationId": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operationId"
        ]
      },
      "output": {
        "properties": {
          "operationId": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "progress": {
            "properties": {
              "phase": {
                "type": "string"
              },
              "done": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "blockedBy": {
            "properties": {
              "operationId": {
                "type": "string"
              },
              "capability": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "result": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operationId",
          "capability",
          "state"
        ]
      }
    },
    {
      "name": "system.capabilities",
      "kind": "query",
      "scope": "global",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.1.0",
      "description": "Lists every capability the core exposes, with its scope, statefulness, annotations and availability. This is the discovery entry point: it reports what is available rather than assuming a fixed surface.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "input": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      },
      "output": {
        "properties": {
          "version": {
            "type": "string"
          },
          "capabilities": {
            "items": {
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "statefulness": {
                  "type": "string"
                },
                "longRunning": {
                  "type": "boolean"
                },
                "audience": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "available": {
                  "type": "boolean"
                },
                "unavailableReason": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "type": "object"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object"
      }
    },
    {
      "name": "system.health",
      "kind": "query",
      "scope": "global",
      "statefulness": "stateless",
      "audience": "all",
      "since": "0.1.0",
      "description": "Reports whether the core is alive, its version and how long it has been running.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "input": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      },
      "output": {
        "properties": {
          "uptimeSeconds": {
            "type": "integer"
          },
          "version": {
            "type": "string"
          },
          "operations": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object"
      }
    }
  ]
}
